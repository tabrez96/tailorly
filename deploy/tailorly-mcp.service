[Unit]
Description=Tailorly MCP server
After=network.target postgresql.service
Requires=postgresql.service

[Service]
User=tailorly
Group=tailorly
WorkingDirectory=/srv/tailorly
EnvironmentFile=/etc/tailorly/tailorly.env
EnvironmentFile=-/etc/tailorly/release.env
ExecStart=/srv/tailorly/.venv/bin/python manage.py run_mcp --host 127.0.0.1 --port 8001
Restart=on-failure

[Install]
WantedBy=multi-user.target
