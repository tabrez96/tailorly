# Copy to /srv/tailorly/.env (owner root, mode 600) and fill in. Compose reads it.
# New key: docker compose run --rm --no-deps web python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# Keep the single quotes: a key can contain ( ) & $ and Compose reads single-quoted values literally.
SECRET_KEY='replace-me-with-a-new-random-key-from-the-command-above-0123456789'
# Database password, used by the db service and in DATABASE_URL (compose.yaml builds it).
# Hex only, so it needs no escaping in the URL: openssl rand -hex 24
POSTGRES_PASSWORD=replace-me-with-openssl-rand-hex-24
DEBUG=0
ALLOWED_HOSTS=shop.example.com
CSRF_TRUSTED_ORIGINS=https://shop.example.com
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000
SHOP_NAME="Your shop name"
MCP_SERVER_URL=https://shop.example.com/mcp
