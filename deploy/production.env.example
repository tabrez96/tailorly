# Copy to /etc/tailorly/tailorly.env (owner root, group tailorly, mode 640) and fill in.
# New key: uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# Keep the single quotes: a key can contain ( ) & $ and the file is also sourced by a shell.
SECRET_KEY='replace-me-with-a-new-random-key-from-the-command-above-0123456789'
DEBUG=0
# Unix socket, peer authentication: no database password anywhere.
DATABASE_URL=postgres:///tailorly
ALLOWED_HOSTS=shop.example.com
CSRF_TRUSTED_ORIGINS=https://shop.example.com
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000
MEDIA_ROOT=/var/lib/tailorly/media
BACKUP_DIR=/var/backups/tailorly
SHOP_NAME="Your shop name"
MCP_SERVER_URL=https://shop.example.com/mcp
